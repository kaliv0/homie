###  Homie config  ###
homie start

__homie_history()
{
    local output before after
    output=$(homie history "$@")
    before="${READLINE_LINE:0:READLINE_POINT}"
    after="${READLINE_LINE:READLINE_POINT}"
    READLINE_LINE="${before}${output}${after}"
    READLINE_POINT=$((READLINE_POINT + ${#output}))
}

# NB: \C-h might conflict with traditional backspace mapping -> change to whatever you like
bind -x '"\C-h": __homie_history'
bind -x '"\C-p": __homie_history --paste'
